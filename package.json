{
  "name": "fluxo",
  "version": "1.0.0",
  "description": "Intelligent Music Crossover Desktop Application for Windows",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "package": "npm run build && npx electron-rebuild -f -w better-sqlite3 && electron-builder",
    "package:dir": "npm run build && npx electron-rebuild -f -w better-sqlite3 && electron-builder --dir",
    "package:portable": "npm run build && npx electron-rebuild -f -w better-sqlite3 && electron-builder --win portable",
    "package:nsis": "npm run build && npx electron-rebuild -f -w better-sqlite3 && electron-builder --win nsis",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "dj",
    "music",
    "crossover",
    "audio-mixing",
    "beatmatching",
    "mashup",
    "electron"
  ],
  "author": "Fluxo Contributors",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "lucide-react": "^0.475.0",
    "music-metadata": "^10.8.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "com.fluxo.desktop",
    "productName": "Fluxo",
    "copyright": "Copyright © 2026 Fluxo Contributors",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fluxo"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
